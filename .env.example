# Copy to .env (or export in the service) and fill in real values.
# Generate random secrets e.g. with: python -c "import secrets; print(secrets.token_hex(32))"

FLASK_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# MariaDB
DB_USER=lufihome
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homedb

# Fernet key that decrypts the Tuya API credentials stored in the DB settings table
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
